[flake8]
# Match the ruff format default line length
max-line-length = 88

# Ignore conflicts between flake8 rules and ruff/black formatting
extend-ignore =
    # Whitespace before ':' (conflicts with ruff format)
    E203,
    # Line break before binary operator (ruff format prefers this)
    W503,
    # Missing docstring rules (optional, if you want to skip them)
    D100,D101,D102,D103,D104,D107
